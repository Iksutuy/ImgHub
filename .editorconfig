# ============================================================================
# .editorconfig —— Roslyn 分析器规则的取舍
# ============================================================================
# 背景：Directory.Build.props 里设了 AnalysisMode=All，打开全部 CAxxxx 规则。
# 实测把 App 项目警告从 114 条推到 716 条。若原样保留，真问题会被噪音淹没，
# 规则也就失去意义。下面每一条降级都写明「为什么这不是缺陷」。
#
# 原则：**降级 = 有据可查的误报，不是图省事**。凡是真实缺陷一律保留警告。
# 状态：none = 关闭，suggestion/warning 可按需调整。
# ============================================================================

root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{axaml,xml,csproj,props,targets,slnx,json}]
indent_size = 2

[*.{md,yml,yaml}]
indent_size = 2
trim_trailing_whitespace = false

# ============================================================================
# 以下规则设置**只作用于 C# 文件**（段落头必须是 [*.cs]，否则会落到上面的
# markdown 段里而不生效 —— 这是 editorconfig 的常见坑）。
# ============================================================================
[*.cs]

# ============================================================================
# CA1031：不要捕获通用异常类型
# 降级理由：本项目 App 层大量 `catch (Exception ex)` 是**有意的顶层兜底**
# —— 见 MainViewModel.Safe() 包装、MainView.axaml.cs 的 async void 事件处理器。
# 这类位置必须兜住一切异常以保持 UI 存活，否则一个异常就是整个应用崩溃。
# 真正需要关注的「吞掉异常不记录」已由下方 CA1031 的使用规范 + 代码评审把关。
# ============================================================================
dotnet_diagnostic.CA1031.severity = none

# ============================================================================
# CA1307 / CA1310 / CA1305：StringComparison / IFormatProvider 显式化
# 降级理由：本项目是**中文单语**客户端，UI 文本比较与格式化不涉及跨区域语义；
# 且 Avalonia XAML 绑定路径、配置键、JSON 字段名都是固定 ASCII 标识符。
# 强制补 StringComparison.Ordinal 属噪音，不改变任何行为。
# ============================================================================
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1305.severity = none

# ============================================================================
# CA2007：对 await 调用 ConfigureAwait(false)
# 降级理由：本项目的异步代码运行在 Avalonia UI 线程上，**必须回到 UI 线程**
# 更新绑定属性。加 ConfigureAwait(false) 反而会破坏 UI 更新，是危险的「修复」。
# 这是该规则在 UI 框架项目的经典误报。
# ============================================================================
dotnet_diagnostic.CA2007.severity = none

# ============================================================================
# CA1062：对公共方法参数做 null 校验
# 降级理由：本项目 <Nullable>enable</Nullable> 已全局开启，可空性由编译器的
# 流分析保证，这是比运行时 null 检查更强的静态契约。重复手工校验属冗余。
# ============================================================================
dotnet_diagnostic.CA1062.severity = none

# ============================================================================
# CA1822：成员可标记为 static
# 降级理由：Avalonia/MVVM 的 [RelayCommand] 与 [ObservableProperty] 生成代码
# 依赖实例成员；XAML 绑定的事件处理器、命令也必须保持实例方法。
# 标成 static 会直接破坏数据绑定。纯风格建议，保留为 suggestion。
# ============================================================================
dotnet_diagnostic.CA1822.severity = suggestion

# ============================================================================
# CA1002 / CA1819 / CA2227：不要暴露 List<T> / 数组属性 / 可写集合属性
# 降级理由：MVVM 绑定需要 ObservableCollection 与可读写集合属性，
# 这是 CommunityToolkit.Mvvm + Avalonia 的标准用法，不是封装缺陷。
# ============================================================================
dotnet_diagnostic.CA1002.severity = suggestion
dotnet_diagnostic.CA1819.severity = suggestion
dotnet_diagnostic.CA2227.severity = suggestion

# ============================================================================
# CA5394：不要使用不安全的随机数生成器
# 降级理由：**已核实全部 2 处，均与安全无关**——
#   ImageApi.cs:444   轮询抖动 `pollInterval + Random.Shared.NextDouble()*0.5`
#   HttpJsonClient.cs:163  重试退避抖动 `baseDelay + Random.Shared.NextDouble()*0.4`
# 两处都是给退避/轮询加随机抖动以避免惊群，不用于任何令牌、密钥或会话 ID。
# ============================================================================
dotnet_diagnostic.CA5394.severity = none

# ============================================================================
# CA5350：不要使用弱加密算法
# 降级理由：**已核实唯一 1 处**——ImageApi.UploadKey() 用 SHA1 对
# 「图片前 512 字节 + 后 512 字节」做**上传去重缓存键**（本地 _uploadCache 的
# key），不用于签名、认证或完整性校验，碰撞后果仅是缓存命中错图。
# 换成 SHA256 反而增加每次上传的哈希开销。这是哈希用于「去重」而非「安全」的
# 经典误报。
# ============================================================================
dotnet_diagnostic.CA5350.severity = none

# ============================================================================
# CA2000：释放对象前对 Dispose 的所有引用应超出范围
# 降级理由：**已核实均为误报**，属「所有权转移」模式：
#   HttpJsonClient.cs:36   `new SocketsHttpHandler` → 立刻交给 `new HttpClient(handler)`。
#                          HttpClient 接管 handler 的生命周期，该字段随类型一起存活，
#                          不是泄漏。
#   HttpJsonClient.cs:265  `new ByteArrayContent(...)` → 交给 HttpRequestMessage 发送，
#                          由框架在请求完成后释放。
#   tests/...PendingTaskTests.cs  测试内构造的 handler/HttpClient 随测试结束回收。
# 保留此规则会造成大量这种误报，故降级为 suggestion（仍可见，不刷屏）。
# ============================================================================
dotnet_diagnostic.CA2000.severity = suggestion

# ============================================================================
# CA1308：字符串应规范化为大写
# 降级理由：这条规则建议把 ToLowerInvariant() 换成 ToUpperInvariant()，仅在
# 字符串被用作**往返可逆的规范化标识**时才有意义（大小写折叠本身不可逆）。
# 本项目用 ToLowerInvariant 做 provider/模型名的**不区分大小写比较**，
# 属该规则的已知误用场景。
# ============================================================================
dotnet_diagnostic.CA1308.severity = none

# ============================================================================
# CA1054 / CA1056：URI 参数/属性不应为字符串
# 降级理由：本项目 provider 的 baseUrl 直接来自用户配置（config.json）与
# 服务端返回，全程以字符串参与 JSON 序列化（AOT 源生成器）。改 System.Uri
# 会破坏 AOT JSON 契约，收益为负。
# ============================================================================
dotnet_diagnostic.CA1054.severity = suggestion
dotnet_diagnostic.CA1056.severity = suggestion

# ============================================================================
# CA1861：避免常量数组作为实参
# 降级理由：纯性能微优化（避免每次调用分配数组），在 UI 事件路径上无实测收益。
# ============================================================================
dotnet_diagnostic.CA1861.severity = suggestion

# ============================================================================
# CA1034：嵌套类型不应可见
# 降级理由：`RegionCanvas.RegionTool`、`RegionSnapshot` 等嵌套类型是
# 控件对内暴露的契约，嵌套正是为了限定作用域。提升到命名空间反而污染 API 面。
# ============================================================================
dotnet_diagnostic.CA1034.severity = suggestion

# ============================================================================
# CA1707：标识符不应包含下划线
# 降级理由：测试方法名用下划线分段（如 `RegionCanvas_NoShapes_ExportsNull`）是
# xUnit 的通行命名惯例，可读性优于驼峰。仅作用于 `*.Tests` 项目，
# 生产代码不受影响（见下方对测试目录的单独段落）。
# ============================================================================
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
# 测试替身/桩对象实现 IDisposable 时不走完整 Dispose 模式，属正常
dotnet_diagnostic.CA1063.severity = suggestion
dotnet_diagnostic.CA1816.severity = suggestion
# 测试里断言抛异常用同步 API 即可，不强制异步
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.CA1866.severity = suggestion

# ============================================================================
# 以下规则**刻意保留为 warning**（已抽查确认是真问题，不要静音）：
#   CA1032   异常类型缺少标准构造函数 —— 会让异常无法被通用 catch 正确还原
#   CA1001   拥有 IDisposable 字段的类型未实现 IDisposable —— 真实资源泄漏风险
#   CA1508   恒真/恒假的死条件 —— 可能是逻辑错误
#   CA1068   CancellationToken 应为最后一个参数 —— 契约一致性
#   CS8618   不可空字段未初始化 —— 真实 null 风险（Nullable 已开启）
#   MVVMTK0034 直接引用 [ObservableProperty] 背后的字段 —— 会绕过变更通知
# ============================================================================
