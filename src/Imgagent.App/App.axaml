<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Imgagent.App.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="AppBg">#F7F8FA</Color>
          <Color x:Key="AppSurface">#FFFFFF</Color>
          <Color x:Key="AppSurfaceAlt">#F2F3F5</Color>
          <Color x:Key="AppBorder">#E5E6EB</Color>
          <Color x:Key="AppBorderStrong">#C9CDD4</Color>
          <Color x:Key="AppText">#1D2129</Color>
          <Color x:Key="AppTextSub">#4E5969</Color>
          <Color x:Key="AppTextDim">#86909C</Color>
          <Color x:Key="AppAccent">#3491FA</Color>
          <Color x:Key="AppAccentHover">#206CCF</Color>
          <Color x:Key="AppAccentSoft">#E8F3FF</Color>
          <Color x:Key="AppOk">#00B42A</Color>
          <Color x:Key="AppWarn">#FF7D00</Color>
          <Color x:Key="AppErr">#F53F3F</Color>
          <Color x:Key="AppCost">#D25F00</Color>
          <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBg}" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}" />
          <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAlt}" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="{StaticResource AppBorderStrong}" />
          <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppText}" />
          <SolidColorBrush x:Key="AppTextSubBrush" Color="{StaticResource AppTextSub}" />
          <SolidColorBrush x:Key="AppTextDimBrush" Color="{StaticResource AppTextDim}" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccent}" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHover}" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoft}" />
          <SolidColorBrush x:Key="AppOkBrush" Color="{StaticResource AppOk}" />
          <SolidColorBrush x:Key="AppWarnBrush" Color="{StaticResource AppWarn}" />
          <SolidColorBrush x:Key="AppErrBrush" Color="{StaticResource AppErr}" />
          <SolidColorBrush x:Key="AppCostBrush" Color="{StaticResource AppCost}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <Color x:Key="AppBg">#171717</Color>
          <Color x:Key="AppSurface">#232326</Color>
          <Color x:Key="AppSurfaceAlt">#2E2E30</Color>
          <Color x:Key="AppBorder">#3A3A3C</Color>
          <Color x:Key="AppBorderStrong">#484849</Color>
          <Color x:Key="AppText">#F6F6F6</Color>
          <Color x:Key="AppTextSub">#C5C5C5</Color>
          <Color x:Key="AppTextDim">#929293</Color>
          <Color x:Key="AppAccent">#469AFA</Color>
          <Color x:Key="AppAccentHover">#79C1FC</Color>
          <Color x:Key="AppAccentSoft">#13224B</Color>
          <Color x:Key="AppOk">#23C343</Color>
          <Color x:Key="AppWarn">#FF9A2E</Color>
          <Color x:Key="AppErr">#F76560</Color>
          <Color x:Key="AppCost">#FFB65E</Color>
          <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBg}" />
          <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}" />
          <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="{StaticResource AppSurfaceAlt}" />
          <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
          <SolidColorBrush x:Key="AppBorderStrongBrush" Color="{StaticResource AppBorderStrong}" />
          <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppText}" />
          <SolidColorBrush x:Key="AppTextSubBrush" Color="{StaticResource AppTextSub}" />
          <SolidColorBrush x:Key="AppTextDimBrush" Color="{StaticResource AppTextDim}" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccent}" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHover}" />
          <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoft}" />
          <SolidColorBrush x:Key="AppOkBrush" Color="{StaticResource AppOk}" />
          <SolidColorBrush x:Key="AppWarnBrush" Color="{StaticResource AppWarn}" />
          <SolidColorBrush x:Key="AppErrBrush" Color="{StaticResource AppErr}" />
          <SolidColorBrush x:Key="AppCostBrush" Color="{StaticResource AppCost}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!--
        CJK 字体链（顺序 = 优先级）：
          1. 内嵌的 NotoSansSC（avares://）—— **Android 的中文靠它**，不依赖系统字体
          2. Windows 系统雅黑（桌面端首选，字形/字重更全）
          3. 兜底 sans-serif

        ⚠️ Android 上系统字体名不可靠（Avalonia CJK 回归 #19868/#20195），
        中文会渲染成方框；所以 **必须内嵌字体**（见 CONSTRAINTS D5）。

        ⚠️ 必须用**静态**字体，不能用可变字体（VF）：
        原 NotoSansSC-VF.ttf 的 wght 轴默认值是 100（Thin），
        Avalonia 会按该默认值渲染 → 笔画极细、发虚模糊。
        已用 fontTools 实例化到 wght=400 并子集化（17 MB → 7.15 MB）。
        重新生成：python tools\make-static-font.py
      -->
      <FontFamily x:Key="AppFont">avares://Imgagent.App/Assets/Fonts/NotoSansSC-Regular.ttf#Noto Sans SC, Microsoft YaHei UI, Microsoft YaHei, Noto Sans CJK SC, Segoe UI, sans-serif</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    </Style>
    <Style Selector="TextBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}" /></Style>
    <Style Selector="Button"><Setter Property="FontFamily" Value="{StaticResource AppFont}" /></Style>
    <Style Selector="ComboBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}" /></Style>
    <Style Selector="CheckBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="FontFamily" Value="{StaticResource AppFont}" /></Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource AppTextDimBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    </Style>

    <!-- ============ 自绘标题栏（仿 Reasonix 风格）============ -->
    <!-- 标题栏按钮：无背景、悬停浅灰、关闭按钮悬停红色 -->
    <Style Selector="Button.titlebar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceAltBrush}" />
    </Style>
    <!-- 关闭按钮：悬停变红 -->
    <Style Selector="Button.titlebar.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Button.titlebar.close:pointerover">
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>