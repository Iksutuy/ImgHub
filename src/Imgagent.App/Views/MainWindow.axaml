<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Imgagent.App.Views"
        xmlns:vm="using:Imgagent.App.ViewModels"
        x:Class="Imgagent.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://Imgagent.App/Assets/app-icon.png"
        Width="1180" Height="760" MinWidth="360" MinHeight="480"
        Title="imgagent 工作台"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        SystemDecorations="None"
        Background="Transparent">
  <Border CornerRadius="10" ClipToBounds="True"
          BorderBrush="{DynamicResource AppBorderStrongBrush}" BorderThickness="1"
          Background="{DynamicResource AppBgBrush}">
    <Grid RowDefinitions="40,*">

      <!-- ============ 自绘标题栏（仿 Reasonix：浅色、扁平、与内容一体）============ -->
      <Border Grid.Row="0" Name="TitleBar" Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,6,0">

          <!-- 左：图标 + 标题 + 状态 -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center">
            <Image Source="avares://Imgagent.App/Assets/app-icon.png"
                   Width="20" Height="20" VerticalAlignment="Center"/>
            <TextBlock Text="imgagent 工作台" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextBrush}"/>
            <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextDimBrush}"
                       IsVisible="{Binding IsConfigured}"/>
          </StackPanel>

          <!-- 中：拖拽区（透明，用于拖动窗口） -->
          <Border Grid.Column="1" Name="TitleBarDragArea" Background="Transparent"/>

          <!-- 右：窗口控制按钮（Segoe MDL2 字形） -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                      VerticalAlignment="Center">
            <Button Classes="titlebar" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                    Click="OnMinimizeClick" ToolTip.Tip="最小化"/>
            <Button Classes="titlebar" Content="&#xE922;" FontFamily="Segoe MDL2 Assets"
                    Click="OnMaximizeClick" ToolTip.Tip="最大化 / 还原"/>
            <Button Classes="titlebar close" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                    Click="OnCloseClick" ToolTip.Tip="关闭"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 主内容 -->
      <views:MainView Grid.Row="1"/>
    </Grid>
  </Border>
</Window>
